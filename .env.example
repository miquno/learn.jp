# Database (local, via docker-compose)
DATABASE_URL="postgresql://nihongo:nihongo@localhost:5432/nihongo"

# Auth.js — required.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend) — for verification and reminders
RESEND_API_KEY=""

# Anthropic — AI feedback in the sentence and story builders
ANTHROPIC_API_KEY=""

# Stripe — monthly / yearly / lifetime subscription
# STRIPE_WEBHOOK_SECRET locally from:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
STRIPE_PRICE_LIFETIME=""

# Sentry — without a DSN Sentry never initialises and the app runs normally.
# ORG/PROJECT/AUTH_TOKEN are only needed for the source-map upload at build.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
