# Datenbank (lokal via docker-compose)
DATABASE_URL="postgresql://nihongo:nihongo@localhost:5432/nihongo"

# Auth.js — Pflicht.
# Erzeugen mit: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# E-Mail (Resend) — für Verifikation und Erinnerungen
RESEND_API_KEY=""

# Anthropic — KI-Korrektur in Sentence Builder und Story Builder (Phase 5)
ANTHROPIC_API_KEY=""

# Stripe — Abo monatlich/jährlich/Lifetime (Phase 8)
# STRIPE_WEBHOOK_SECRET lokal aus:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
STRIPE_PRICE_LIFETIME=""

# Sentry — ohne DSN wird Sentry nie initialisiert, die App läuft normal weiter.
# ORG/PROJECT/AUTH_TOKEN nur für den Source-Map-Upload beim Build nötig.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
