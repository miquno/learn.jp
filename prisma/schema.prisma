// Teil 1 — Nutzer, Auth, Einstellungen.
// Teil 2 — Lerninhalte (unten): Kana, Vokabeln, Kanji, Radikale, Beispielsätze.
// Fortschritt/SRS folgt in Phase 2, Grammatik in Phase 3, Gamification in Phase 6.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  pending
  active
  banned
}

enum UserTier {
  free
  premium
  lifetime
}

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

enum Locale {
  de
  en
}

enum TokenType {
  email_verification
  password_reset
}

model User {
  id           String  @id @default(cuid())
  /// Fortlaufende Nummer für öffentliche Profil-URLs (/profile/1234),
  /// damit die cuid nicht nach außen wandert.
  userNumber   Int     @unique @default(autoincrement())
  email        String  @unique
  username     String  @unique
  passwordHash String?

  role   UserRole   @default(user)
  status UserStatus @default(pending)

  emailVerifiedAt DateTime?
  avatarUrl       String?
  discordId       String?   @unique

  // Lernprofil
  currentLevel JlptLevel?
  goalLevel    JlptLevel?
  /// Welche JLPT-Stufen im Review-Pool auftauchen. Leer = alle.
  reviewLevels JlptLevel[]

  // Einstellungen
  locale          Locale  @default(de)
  dailyGoalVocab  Int     @default(5)
  dailyGoalGrammar Int    @default(2)
  audioSpeed      Float   @default(1.0)
  answerFeedback  Boolean @default(true)
  mascotsEnabled  Boolean @default(true)
  hideActivity    Boolean @default(false)
  pushEnabled     Boolean @default(false)

  // Fortschritt auf Kontoebene
  coins         Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyAt   DateTime?

  // Abo
  tier                     UserTier  @default(free)
  trialEndsAt              DateTime?
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens AuthToken[]

  @@map("users")
}

model AuthToken {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Teil 2 — Lerninhalte
//
// Alle Inhalte sind nutzerunabhängig und werden per Importer aus offenen
// Quellen befüllt (scripts/import/). Zweisprachige Felder liegen als JSON
// `{ de: [...], en: [...] }` statt in Übersetzungstabellen: JMdict und Tatoeba
// liefern deutsche Fassungen direkt mit, und die Felder werden praktisch
// immer gemeinsam mit ihrem Datensatz gelesen.
// ---------------------------------------------------------------------------

enum KanaScript {
  hiragana
  katakana
}

enum KanaType {
  basic
  dakuten
  handakuten
  combo
}

/// Konjugationsklasse — bestimmt, welche Formen ein Wort bilden kann.
enum WordClass {
  godan
  ichidan
  irregular
  i_adjective
  na_adjective
  other
}

model Kana {
  id        String     @id @default(cuid())
  character String
  romaji    String
  script    KanaScript
  type      KanaType   @default(basic)
  /// Zeile der Kana-Tafel (a, ka, sa …) — die Lernreihenfolge folgt ihr.
  row       String
  order     Int

  @@unique([character, script])
  @@index([script, order])
  @@map("kana")
}

model Word {
  id       String @id @default(cuid())
  /// JMdict-Eintragsnummer (ent_seq). Stabil über Neuimporte hinweg und
  /// damit der Anker für idempotente Aktualisierungen.
  sourceId Int?   @unique

  /// Schreibung in Kanji. Leer bei Wörtern, die nur in Kana existieren.
  written String?
  /// Lesung in Kana — immer gesetzt.
  reading String
  romaji  String

  /// { de: string[], en: string[] }
  meanings     Json
  partOfSpeech String[]
  wordClass    WordClass @default(other)

  jlptLevel JlptLevel?
  /// Häufigkeitsrang aus JMdict (kleiner = häufiger). Bestimmt zusammen mit
  /// dem JLPT-Level die Lernreihenfolge.
  frequency Int?
  isCommon  Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentences WordSentence[]
  kanji     KanjiWord[]

  @@index([jlptLevel, frequency])
  @@index([reading])
  @@map("words")
}

model Kanji {
  id        String @id @default(cuid())
  character String @unique

  /// { de: string[], en: string[] }
  /// Achtung: KANJIDIC2 liefert Englisch, Französisch, Spanisch und
  /// Portugiesisch — aber kein Deutsch. `de` bleibt nach dem Import leer und
  /// wird in einem eigenen Schritt gefüllt.
  meanings    Json
  onyomi      String[]
  kunyomi     String[]
  strokeCount Int

  jlptLevel JlptLevel?
  /// Schuljahr der japanischen Grundschule (1–6) bzw. 8 für Jōyō-Kanji
  /// der Sekundarstufe. Nützlich als Reihenfolge, wo JLPT-Daten fehlen.
  grade     Int?
  frequency Int?

  /// SVG-Pfade der Striche aus KanjiVG, in Schreibreihenfolge.
  strokeOrder Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words    KanjiWord[]
  radicals KanjiRadical[]

  @@index([jlptLevel, frequency])
  @@index([grade])
  @@map("kanji")
}

model Radical {
  id        String @id @default(cuid())
  character String @unique
  /// { de: string[], en: string[] }
  meanings    Json
  reading     String?
  strokeCount Int

  kanji KanjiRadical[]

  @@map("radicals")
}

model KanjiRadical {
  kanjiId   String
  kanji     Kanji   @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  radicalId String
  radical   Radical @relation(fields: [radicalId], references: [id], onDelete: Cascade)

  @@id([kanjiId, radicalId])
  @@map("kanji_radicals")
}

model KanjiWord {
  kanjiId String
  kanji   Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  wordId  String
  word    Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([kanjiId, wordId])
  @@map("kanji_words")
}

model Sentence {
  id       String @id @default(cuid())
  /// Tatoeba-Satz-ID.
  sourceId Int?   @unique

  japanese String
  /// { de?: string, en?: string } — nicht jeder Satz hat beide Sprachen.
  translations Json

  /// Anzahl enthaltener Kanji und Zeichenlänge bestimmen, ab welchem Niveau
  /// ein Satz als Beispiel taugt.
  charCount  Int
  kanjiCount Int
  jlptLevel  JlptLevel?

  createdAt DateTime @default(now())

  words WordSentence[]

  @@index([jlptLevel, charCount])
  @@map("sentences")
}

model WordSentence {
  wordId     String
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentenceId String
  sentence   Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@id([wordId, sentenceId])
  @@index([sentenceId])
  @@map("word_sentences")
}
