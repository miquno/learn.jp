// Teil 1 — Nutzer, Auth, Einstellungen.
// Teil 2 — Lerninhalte (unten): Kana, Vokabeln, Kanji, Radikale, Beispielsätze.
// Fortschritt/SRS folgt in Phase 2, Grammatik in Phase 3, Gamification in Phase 6.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  pending
  active
  banned
}

enum UserTier {
  free
  premium
  lifetime
}

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

enum Locale {
  de
  en
}

enum TokenType {
  email_verification
  password_reset
}

model User {
  id           String  @id @default(cuid())
  /// Fortlaufende Nummer für öffentliche Profil-URLs (/profile/1234),
  /// damit die cuid nicht nach außen wandert.
  userNumber   Int     @unique @default(autoincrement())
  email        String  @unique
  username     String  @unique
  passwordHash String?

  role   UserRole   @default(user)
  status UserStatus @default(pending)

  emailVerifiedAt DateTime?
  avatarUrl       String?
  discordId       String?   @unique

  // Lernprofil
  currentLevel JlptLevel?
  goalLevel    JlptLevel?
  /// Welche JLPT-Stufen im Review-Pool auftauchen. Leer = alle.
  reviewLevels JlptLevel[]

  // Einstellungen
  locale          Locale  @default(de)
  dailyGoalVocab  Int     @default(5)
  dailyGoalGrammar Int    @default(2)
  audioSpeed      Float   @default(1.0)
  answerFeedback  Boolean @default(true)
  mascotsEnabled  Boolean @default(true)
  hideActivity    Boolean @default(false)
  pushEnabled     Boolean @default(false)

  // Fortschritt auf Kontoebene
  coins         Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyAt   DateTime?

  // Abo
  tier                     UserTier  @default(free)
  trialEndsAt              DateTime?
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens        AuthToken[]
  srsCards      SrsCard[]
  dailyActivity DailyActivity[]

  @@map("users")
}

model AuthToken {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Teil 2 — Lerninhalte
//
// Alle Inhalte sind nutzerunabhängig und werden per Importer aus offenen
// Quellen befüllt (scripts/import/). Zweisprachige Felder liegen als JSON
// `{ de: [...], en: [...] }` statt in Übersetzungstabellen: JMdict und Tatoeba
// liefern deutsche Fassungen direkt mit, und die Felder werden praktisch
// immer gemeinsam mit ihrem Datensatz gelesen.
// ---------------------------------------------------------------------------

enum KanaScript {
  hiragana
  katakana
}

enum KanaType {
  basic
  dakuten
  handakuten
  combo
}

/// Konjugationsklasse — bestimmt, welche Formen ein Wort bilden kann.
enum WordClass {
  godan
  ichidan
  irregular
  i_adjective
  na_adjective
  other
}

model Kana {
  id        String     @id @default(cuid())
  character String
  romaji    String
  script    KanaScript
  type      KanaType   @default(basic)
  /// Zeile der Kana-Tafel (a, ka, sa …) — die Lernreihenfolge folgt ihr.
  row       String
  order     Int

  srsCards SrsCard[]

  @@unique([character, script])
  @@index([script, order])
  @@map("kana")
}

model Word {
  id       String @id @default(cuid())
  /// JMdict-Eintragsnummer (ent_seq). Stabil über Neuimporte hinweg und
  /// damit der Anker für idempotente Aktualisierungen.
  sourceId Int?   @unique

  /// Schreibung in Kanji. Leer bei Wörtern, die nur in Kana existieren.
  written String?
  /// Lesung in Kana — immer gesetzt.
  reading String
  romaji  String

  /// { de: string[], en: string[] }
  meanings     Json
  partOfSpeech String[]
  wordClass    WordClass @default(other)

  jlptLevel JlptLevel?
  /// Häufigkeitsrang aus JMdict (kleiner = häufiger). Bestimmt zusammen mit
  /// dem JLPT-Level die Lernreihenfolge.
  frequency Int?
  isCommon  Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentences WordSentence[]
  kanji     KanjiWord[]
  srsCards  SrsCard[]

  @@index([jlptLevel, frequency])
  @@index([reading])
  @@map("words")
}

model Kanji {
  id        String @id @default(cuid())
  character String @unique

  /// { de: string[], en: string[] }
  /// Achtung: KANJIDIC2 liefert Englisch, Französisch, Spanisch und
  /// Portugiesisch — aber kein Deutsch. `de` bleibt nach dem Import leer und
  /// wird in einem eigenen Schritt gefüllt.
  meanings    Json
  onyomi      String[]
  kunyomi     String[]
  strokeCount Int

  /// Abgeleitete Stufe der heutigen fünfstufigen Skala (siehe scripts/import/jlpt.ts).
  jlptLevel JlptLevel?
  /// Rohwert aus KANJIDIC2 auf der *alten* vierstufigen Skala (4 = leichteste).
  /// Getrennt gespeichert, damit die Ableitung wiederholbar bleibt und nicht
  /// beim zweiten Lauf ihr eigenes Ergebnis als Quelle liest.
  sourceJlpt Int?
  /// Schuljahr der japanischen Grundschule (1–6) bzw. 8 für Jōyō-Kanji
  /// der Sekundarstufe. Nützlich als Reihenfolge, wo JLPT-Daten fehlen.
  grade     Int?
  frequency Int?

  /// SVG-Pfade der Striche aus KanjiVG, in Schreibreihenfolge.
  strokeOrder Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words    KanjiWord[]
  radicals KanjiRadical[]
  srsCards SrsCard[]

  @@index([jlptLevel, frequency])
  @@index([grade])
  @@map("kanji")
}

model Radical {
  id        String @id @default(cuid())
  character String @unique
  /// { de: string[], en: string[] }
  meanings    Json
  reading     String?
  strokeCount Int

  kanji KanjiRadical[]

  @@map("radicals")
}

model KanjiRadical {
  kanjiId   String
  kanji     Kanji   @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  radicalId String
  radical   Radical @relation(fields: [radicalId], references: [id], onDelete: Cascade)

  @@id([kanjiId, radicalId])
  @@map("kanji_radicals")
}

model KanjiWord {
  kanjiId String
  kanji   Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  wordId  String
  word    Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([kanjiId, wordId])
  @@map("kanji_words")
}

model Sentence {
  id       String @id @default(cuid())
  /// Tatoeba-Satz-ID.
  sourceId Int?   @unique

  japanese String
  /// { de?: string, en?: string } — nicht jeder Satz hat beide Sprachen.
  translations Json

  /// Anzahl enthaltener Kanji und Zeichenlänge bestimmen, ab welchem Niveau
  /// ein Satz als Beispiel taugt.
  charCount  Int
  kanjiCount Int
  jlptLevel  JlptLevel?

  createdAt DateTime @default(now())

  words WordSentence[]

  @@index([jlptLevel, charCount])
  @@map("sentences")
}

model WordSentence {
  wordId     String
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentenceId String
  sentence   Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@id([wordId, sentenceId])
  @@index([sentenceId])
  @@map("word_sentences")
}

// ---------------------------------------------------------------------------
// Teil 3 — Lernfortschritt
//
// Grundsatz: Fortschritt wird *protokolliert*, nicht nur als Zustand gehalten.
// Ohne ReviewLog und DailyActivity gäbe es weder Heatmap noch Streak,
// Rangliste oder Schwächen-Auswertung — und nachträglich lassen sich diese
// Daten nicht rekonstruieren.
// ---------------------------------------------------------------------------

enum SrsItemType {
  kana
  word
  kanji
}

/// Zustände des FSRS-Algorithmus.
enum SrsState {
  new
  learning
  review
  relearning
}

/// Bewertung einer Antwort. Die Zahlenwerte entsprechen FSRS: 1–4.
enum SrsRating {
  again
  hard
  good
  easy
}

model SrsCard {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType SrsItemType

  // Getrennte Fremdschlüssel statt einer polymorphen ID: so räumt die
  // Datenbank verwaiste Karten selbst ab, wenn Inhalte neu importiert werden.
  kanaId  String?
  kana    Kana?  @relation(fields: [kanaId], references: [id], onDelete: Cascade)
  wordId  String?
  word    Word?  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  kanjiId String?
  kanji   Kanji? @relation(fields: [kanjiId], references: [id], onDelete: Cascade)

  // FSRS-Zustand
  state         SrsState  @default(new)
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  /// Position innerhalb der Lernschritte. Ohne dieses Feld begänne eine Karte
  /// in der Lernphase bei jeder Wiederholung wieder beim ersten Schritt.
  learningSteps Int       @default(0)
  lastReviewAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs ReviewLog[]

  // Je Nutzer höchstens eine Karte pro Inhalt. Postgres behandelt NULL-Werte
  // als verschieden, deshalb stören die jeweils leeren Spalten nicht.
  @@unique([userId, kanaId])
  @@unique([userId, wordId])
  @@unique([userId, kanjiId])
  @@index([userId, due])
  @@index([userId, itemType, state])
  @@map("srs_cards")
}

model ReviewLog {
  id     String  @id @default(cuid())
  cardId String
  card   SrsCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// Doppelt geführt, damit Statistiken über Zeiträume ohne Join auskommen.
  userId String

  rating SrsRating
  /// Zustand *vor* dieser Wiederholung — nötig, um den Verlauf später mit
  /// anderen Parametern neu durchrechnen zu können.
  state         SrsState
  stability     Float
  difficulty    Float
  elapsedDays   Int
  scheduledDays Int
  /// Antwortdauer in Millisekunden. Verrät, ob etwas wirklich saß oder nur
  /// mühsam erraten wurde.
  durationMs Int?

  reviewedAt DateTime @default(now())

  @@index([userId, reviewedAt])
  @@index([cardId, reviewedAt])
  @@map("review_logs")
}

/// Eine Zeile je Nutzer und Tag. Grundlage für Heatmap, Streak und Rangliste.
model DailyActivity {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Auf UTC-Mitternacht normalisiert. Eine echte Zeitzone je Nutzer fehlt
  /// noch — wer spätabends lernt, bekommt den Beitrag je nach Ort dem
  /// Folgetag gutgeschrieben. Für Heatmap und Streak vertretbar, für die
  /// Rangliste später nachzuziehen.
  date   DateTime @db.Date

  reviews  Int @default(0)
  correct  Int @default(0)
  newItems Int @default(0)
  seconds  Int @default(0)

  @@id([userId, date])
  @@index([date])
  @@map("daily_activity")
}
