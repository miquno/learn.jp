// Part 1 — users, auth, settings.
// Part 2 — learning content (below): kana, words, kanji, radicals, sentences.
// Part 3 — learning progress. Part 4 — coins and avatar.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  pending
  active
  banned
}

enum UserTier {
  free
  premium
  lifetime
}

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

enum Locale {
  de
  en
}

enum TokenType {
  email_verification
  password_reset
}

model User {
  id           String  @id @default(cuid())
  /// Sequential number for public profile URLs (/profile/1234), so the cuid
  /// never leaves the system.
  userNumber   Int     @unique @default(autoincrement())
  email        String  @unique
  username     String  @unique
  passwordHash String?

  role   UserRole   @default(user)
  status UserStatus @default(pending)

  emailVerifiedAt DateTime?
  avatarUrl       String?
  discordId       String?   @unique

  // Learning profile
  currentLevel JlptLevel?
  goalLevel    JlptLevel?
  /// Which JLPT levels appear in the review pool. Empty = all.
  reviewLevels JlptLevel[]

  // Settings
  locale          Locale  @default(de)
  dailyGoalVocab  Int     @default(5)
  dailyGoalGrammar Int    @default(2)
  audioSpeed      Float   @default(1.0)
  answerFeedback  Boolean @default(true)
  mascotsEnabled  Boolean @default(true)
  hideActivity    Boolean @default(false)
  pushEnabled     Boolean @default(false)

  // Account-level progress
  coins         Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyAt   DateTime?

  // Subscription
  tier                     UserTier  @default(free)
  trialEndsAt              DateTime?
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens        AuthToken[]
  srsCards      SrsCard[]
  dailyActivity DailyActivity[]
  inventory     InventoryItem[]
  coinLog       CoinTransaction[]
  loadout       AvatarLoadout?

  @@map("users")
}

model AuthToken {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Part 2 — learning content
//
// All content is user-independent and filled by importers from open sources
// (scripts/import/). Bilingual fields are JSON `{ de: [...], en: [...] }`
// rather than translation tables: JMdict and Tatoeba ship German versions
// directly, and these fields are practically always read together with their
// record.
// ---------------------------------------------------------------------------

enum KanaScript {
  hiragana
  katakana
}

enum KanaType {
  basic
  dakuten
  handakuten
  combo
}

/// Conjugation class — determines which forms a word can take.
enum WordClass {
  godan
  ichidan
  irregular
  i_adjective
  na_adjective
  other
}

model Kana {
  id        String     @id @default(cuid())
  character String
  romaji    String
  script    KanaScript
  type      KanaType   @default(basic)
  /// Row of the kana table (a, ka, sa …) — learning order follows it.
  row       String
  order     Int

  srsCards SrsCard[]

  @@unique([character, script])
  @@index([script, order])
  @@map("kana")
}

model Word {
  id       String @id @default(cuid())
  /// JMdict entry number (ent_seq). Stable across re-imports and therefore
  /// the anchor for idempotent updates.
  sourceId Int?   @unique

  /// Kanji spelling. Empty for words that only exist in kana.
  written String?
  /// Reading in kana — always set.
  reading String
  romaji  String

  /// { de: string[], en: string[] }
  meanings     Json
  partOfSpeech String[]
  wordClass    WordClass @default(other)

  jlptLevel JlptLevel?
  /// Frequency rank from JMdict (lower = more common). Together with the JLPT
  /// level it determines learning order.
  frequency Int?
  isCommon  Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentences WordSentence[]
  kanji     KanjiWord[]
  srsCards  SrsCard[]

  @@index([jlptLevel, frequency])
  @@index([reading])
  @@map("words")
}

model Kanji {
  id        String @id @default(cuid())
  character String @unique

  /// { de: string[], en: string[] }
  /// Note: KANJIDIC2 ships English, French, Spanish and Portuguese — but no
  /// German. `de` stays empty after import and is filled in a separate step.
  meanings    Json
  onyomi      String[]
  kunyomi     String[]
  strokeCount Int

  /// Derived level on today's five-step scale (see scripts/import/jlpt.ts).
  jlptLevel JlptLevel?
  /// Raw value from KANJIDIC2 on the *old* four-step scale (4 = easiest).
  /// Stored separately so the derivation stays repeatable and doesn't read its
  /// own output as input on a second run.
  sourceJlpt Int?
  /// Japanese school grade (1–6), or 8 for secondary-school Jōyō kanji.
  /// Useful as an ordering where JLPT data is missing.
  grade     Int?
  frequency Int?

  /// SVG stroke paths from KanjiVG, in writing order.
  strokeOrder Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words    KanjiWord[]
  radicals KanjiRadical[]
  srsCards SrsCard[]

  @@index([jlptLevel, frequency])
  @@index([grade])
  @@map("kanji")
}

model Radical {
  id        String @id @default(cuid())
  character String @unique
  /// { de: string[], en: string[] }
  meanings    Json
  reading     String?
  strokeCount Int

  kanji KanjiRadical[]

  @@map("radicals")
}

model KanjiRadical {
  kanjiId   String
  kanji     Kanji   @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  radicalId String
  radical   Radical @relation(fields: [radicalId], references: [id], onDelete: Cascade)

  @@id([kanjiId, radicalId])
  @@map("kanji_radicals")
}

model KanjiWord {
  kanjiId String
  kanji   Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  wordId  String
  word    Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([kanjiId, wordId])
  @@map("kanji_words")
}

model Sentence {
  id       String @id @default(cuid())
  /// Tatoeba sentence id.
  sourceId Int?   @unique

  japanese String
  /// { de?: string, en?: string } — not every sentence has both languages.
  translations Json

  /// Kanji count and character length decide from which level a sentence is
  /// usable as an example.
  charCount  Int
  kanjiCount Int
  jlptLevel  JlptLevel?

  createdAt DateTime @default(now())

  words WordSentence[]

  @@index([jlptLevel, charCount])
  @@map("sentences")
}

model WordSentence {
  wordId     String
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentenceId String
  sentence   Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@id([wordId, sentenceId])
  @@index([sentenceId])
  @@map("word_sentences")
}

// ---------------------------------------------------------------------------
// Part 3 — learning progress
//
// Principle: progress is *logged*, not merely held as state. Without ReviewLog
// and DailyActivity there would be no heatmap, streak, leaderboard or weakness
// analysis — and none of that data can be reconstructed after the fact.
// ---------------------------------------------------------------------------

enum SrsItemType {
  kana
  word
  kanji
}

/// States of the FSRS algorithm.
enum SrsState {
  new
  learning
  review
  relearning
}

/// Rating of an answer. The numeric values match FSRS: 1–4.
enum SrsRating {
  again
  hard
  good
  easy
}

model SrsCard {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType SrsItemType

  // Separate foreign keys instead of one polymorphic id: this lets the
  // database clean up orphaned cards itself when content is re-imported.
  kanaId  String?
  kana    Kana?  @relation(fields: [kanaId], references: [id], onDelete: Cascade)
  wordId  String?
  word    Word?  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  kanjiId String?
  kanji   Kanji? @relation(fields: [kanjiId], references: [id], onDelete: Cascade)

  // FSRS state
  state         SrsState  @default(new)
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  /// Position within the learning steps. Without this field a card in the
  /// learning phase would restart at the first step on every review.
  learningSteps Int       @default(0)
  lastReviewAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs ReviewLog[]

  // At most one card per content item per user. Postgres treats NULLs as
  // distinct, so the empty columns don't collide.
  @@unique([userId, kanaId])
  @@unique([userId, wordId])
  @@unique([userId, kanjiId])
  @@index([userId, due])
  @@index([userId, itemType, state])
  @@map("srs_cards")
}

model ReviewLog {
  id     String  @id @default(cuid())
  cardId String
  card   SrsCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// Duplicated so statistics over time ranges need no join.
  userId String

  rating SrsRating
  /// State *before* this review — needed to recompute the history with
  /// different parameters later.
  state         SrsState
  stability     Float
  difficulty    Float
  elapsedDays   Int
  scheduledDays Int
  /// Answer duration in milliseconds. Reveals whether something was solid or
  /// laboriously guessed.
  durationMs Int?

  reviewedAt DateTime @default(now())

  @@index([userId, reviewedAt])
  @@index([cardId, reviewedAt])
  @@map("review_logs")
}

/// One row per user and day. Basis for heatmap, streak and leaderboard.
model DailyActivity {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Normalised to UTC midnight. A real per-user timezone is still missing —
  /// someone studying late gets credited to the following day depending on
  /// where they are. Acceptable for heatmap and streak, to be fixed before the
  /// leaderboard.
  date   DateTime @db.Date

  reviews  Int @default(0)
  correct  Int @default(0)
  newItems Int @default(0)
  seconds  Int @default(0)

  @@id([userId, date])
  @@index([date])
  @@map("daily_activity")
}

// ---------------------------------------------------------------------------
// Part 4 — coins and avatar
//
// Instead of a buildable island like the reference product, there is a pixel
// character to dress up. Two reasons: a layered sprite is far simpler than an
// isometric tile editor with three terrain layers, and it visibly sets the app
// apart from its model.
// ---------------------------------------------------------------------------

enum ItemRarity {
  common
  uncommon
  rare
  epic
  legendary
}

/// Layers of the character, drawn back to front.
enum AvatarSlot {
  background
  hair_back
  body
  bottom
  top
  shoes
  hair
  accessory
}

enum AvatarBase {
  feminine
  masculine
}

model ShopItem {
  id   String @id @default(cuid())
  slug String @unique

  /// { de: string, en: string }
  name        Json
  description Json

  slot   AvatarSlot
  rarity ItemRarity
  price  Int

  /// Key of the artwork in src/lib/avatar/parts.ts. The drawings live in code
  /// rather than as image files — that keeps them crisp at any resolution and
  /// recolourable.
  assetKey String

  /// Usable only with this base. Empty = fits both.
  onlyBase AvatarBase?

  order Int @default(0)

  inventory InventoryItem[]

  @@index([slot, price])
  @@map("shop_items")
}

model InventoryItem {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  acquiredAt DateTime @default(now())

  @@id([userId, itemId])
  @@map("inventory_items")
}

model AvatarLoadout {
  userId String     @id
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  base   AvatarBase @default(feminine)

  /// Hex colours used to tint skin and hair.
  skinTone  String @default("#f2c9a0")
  hairColor String @default("#3b2a24")

  /// { slot: shopItemId } — only occupied layers appear.
  equipped Json @default("{}")

  updatedAt DateTime @updatedAt

  @@map("avatar_loadouts")
}

/// Every coin movement individually. The balance on the user is the running
/// sum; if the two disagree something went wrong and can be traced here.
model CoinTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Positive when earned, negative when spent.
  delta  Int
  reason String
  /// Reference depending on reason: card id when studying, item id on purchase.
  refId  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("coin_transactions")
}
